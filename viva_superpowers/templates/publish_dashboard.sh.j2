#!/usr/bin/env bash
# Build the read-only workbench SPA for this workspace (see the companion
# .github/workflows/publish-dashboard.yml). Scaffolded by
# viva_superpowers.publish_assets.emit(); run it locally to preview the
# bundle.
set -euo pipefail
WS_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
OUT="${1:-$WS_ROOT/reports/published/workbench}"
BASE_PATH="{{ base_path }}"
{% if interactive_url -%}
INTERACTIVE_URL="{{ interactive_url }}"
{% endif -%}
rm -rf "$OUT"
PYTHONPATH="$WS_ROOT${PYTHONPATH:+:$PYTHONPATH}" \
  vivarium-workbench-publish \
    --workspace "$WS_ROOT" \
    --out "$OUT" \
    --base-path "$BASE_PATH"{% if interactive_url %} \
    --interactive-url "$INTERACTIVE_URL"{% endif %}

find "$OUT" -name '*.map' -delete
touch "$OUT/.nojekyll"
echo "built read-only workbench bundle at $OUT ($(du -sh "$OUT" | cut -f1))"
